        audioId: 
        customTags: []
      expanded: 1
    expanded: 1
  - sectionType: 0
    knotName: translating_text
    entries:
    - type: 0
      text: Translating text is a key part of localization. In Unity, you use string
        tables to store translations for different languages.
      targetKnot: 
      choiceDepth: 1
      stickyChoice: 0
      suppressChoiceText: 0
      fallbackChoice: 0
      choiceConditionExpression: 
      gatherDepth: 1
      conditionExpression: isCoop
      elseTargetKnot: 
      rawInk: 
      tags:
        useSpeaker: 0
        speakerId: 
        speakerName: 
        portraitKey: 
        speakerAnimation: 
        useLocale: 1
        localeKey: translating_text
        useLayout: 0
        layoutAnimation: 
        useAudio: 0
        audioId: 
        customTags: []
      expanded: 1
    - type: 0
      text: '1. **Add Entries to String Tables**: Each entry in a string table represents
        a piece of text that needs to be translated. For example, the English string
        table might have an entry for "Start Game," and the Spanish table would have
        "Iniciar Juego."'
      targetKnot: 
      choiceDepth: 1
      stickyChoice: 0
      suppressChoiceText: 0
      fallbackChoice: 0
      choiceConditionExpression: 
      gatherDepth: 1
      conditionExpression: isCoop
      elseTargetKnot: 
      rawInk: 
      tags:
        useSpeaker: 0
        speakerId: 
        speakerName: 
        portraitKey: 
        speakerAnimation: 
        useLocale: 1
        localeKey: translating_text_step1
        useLayout: 0
        layoutAnimation: 
        useAudio: 0
        audioId: 
        customTags: []
      expanded: 1
    - type: 0
      text: '2. **Use the Localize Component**: Attach the `Localize String Event`
        component to UI elements like text fields or buttons. This component will
        automatically display the correct translation based on the selected locale.'
      targetKnot: 
      choiceDepth: 1
      stickyChoice: 0
      suppressChoiceText: 0
      fallbackChoice: 0
      choiceConditionExpression: 
      gatherDepth: 1
      conditionExpression: isCoop
      elseTargetKnot: 
      rawInk: 
      tags:
        useSpeaker: 0
        speakerId: 
        speakerName: 
        portraitKey: 
        speakerAnimation: 
        useLocale: 1
        localeKey: translating_text_step2
        useLayout: 0
        layoutAnimation: 
        useAudio: 0
        audioId: 
        customTags: []
      expanded: 1
    - type: 0
      text: '3. **Preview Translations**: In the Localization Settings, you can switch
        between different locales to preview how the translated text looks in your
        game.'
      targetKnot: 
      choiceDepth: 1
      stickyChoice: 0
      suppressChoiceText: 0
      fallbackChoice: 0
      choiceConditionExpression: 
      gatherDepth: 1
      conditionExpression: isCoop
      elseTargetKnot: 
      rawInk: 
      tags:
        useSpeaker: 0
        speakerId: 
        speakerName: 
        portraitKey: 
        speakerAnimation: 
        useLocale: 1
        localeKey: translating_text_step3
        useLayout: 0
        layoutAnimation: 
        useAudio: 0
        audioId: 
        customTags: []
      expanded: 1
    - type: 1
      text: Go Back
      targetKnot: choose_a_topic
      choiceDepth: 1
      stickyChoice: 0
      suppressChoiceText: 1
      fallbackChoice: 0
      choiceConditionExpression: 
      gatherDepth: 1
      conditionExpression: isCoop
      elseTargetKnot: 
      rawInk: 
